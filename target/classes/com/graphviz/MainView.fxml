<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<!--
    Main view of the Graph Algorithm Visualizer.

    All chrome styling lives in styles.css (attached in Main.java); this file
    only assigns styleClass names. Layout:
      - TOP: two toolbar rows — graph actions, then algorithm playback controls
      - CENTER: a Pane that holds the Canvas; the canvas is bound to the pane's
                size in the controller, so it grows/shrinks with the window
      - BOTTOM: a usage hint and a status label
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.graphviz.controller.MainController">

    <!-- TOP: two toolbar rows stacked in a VBox -->
    <top>
        <VBox styleClass="toolbar-area">

            <!-- Row 1: building the graph and choosing the algorithm -->
            <HBox spacing="10" styleClass="toolbar-row" alignment="CENTER_LEFT">
                <Button text="Create Random Graph" onAction="#onCreateRandomGraph"/>
                <Button text="Clear Graph" onAction="#onClearGraph"/>
                <Separator orientation="VERTICAL"/>
                <Label text="Algorithm" styleClass="section-label"/>
                <ComboBox fx:id="algorithmCombo" onAction="#onAlgorithmChanged"
                          styleClass="algorithm-combo"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="runButton" text="Run" onAction="#onRun"
                        styleClass="button-primary"/>
            </HBox>

            <!-- Row 2: playing the animation -->
            <HBox spacing="8" styleClass="toolbar-row" alignment="CENTER_LEFT">
                <Label text="Playback" styleClass="section-label"/>
                <Button fx:id="playButton"  text="▶ Play"  onAction="#onPlay"  disable="true"/>
                <Button fx:id="pauseButton" text="⏸ Pause" onAction="#onPause" disable="true"/>
                <Button fx:id="stepButton"  text="⏭ Step"  onAction="#onStep"  disable="true"/>
                <Button fx:id="resetButton" text="⟲ Reset" onAction="#onReset" disable="true"/>
                <Separator orientation="VERTICAL"/>
                <!-- A small color legend so the meaning of each color is clear -->
                <Label text="Legend" styleClass="legend-label"/>
                <Label text="● checking"          styleClass="legend-checking"/>
                <Label text="● accepted/improved"  styleClass="legend-accepted"/>
                <Label text="● rejected/cycle"     styleClass="legend-rejected"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER: a resizable holder; the Canvas is bound to its size in the controller -->
    <center>
        <Pane fx:id="canvasHolder" styleClass="canvas-area">
            <Canvas fx:id="graphCanvas"/>
        </Pane>
    </center>

    <!-- BOTTOM: hint line + status message bar -->
    <bottom>
        <VBox styleClass="status-area" spacing="3">
            <!-- Static usage hint so the user always knows how to interact -->
            <Label text="Click empty space = new node  ·  Click node then click another = new edge  ·  Hold &amp; drag node = move  ·  Right-click node = delete  ·  Right-click edge = edit weight"
                   styleClass="hint-label"/>
            <Label fx:id="statusLabel"
                   text="Build a graph, choose an algorithm, then press Run and use the playback controls."
                   styleClass="status-label"/>
        </VBox>
    </bottom>

</BorderPane>
